<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Blocked_Task_Requires_Reason</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Task_Status__c, &quot;Blocked&quot;),
    ISBLANK(Blocked_Reason__c)
)</errorConditionFormula>
    <errorMessage>Blocked tasks must have a Blocked Reason.</errorMessage>
</ValidationRule>
