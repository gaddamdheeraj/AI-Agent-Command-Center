<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Task_Status</name>
        <label>Check Task Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Needs_Attention</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Task_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Overdue_Task_Issue</targetReference>
            </connector>
            <label>Needs Attention</label>
        </rules>
    </decisions>
    <description>Scheduled automation that identifies due Project Tasks that are not completed, creates an Operational Issue for attention, and logs Flow errors through a fault path.</description>
    <environments>Default</environments>
    <formulas>
        <name>Flow_Error_Name</name>
        <dataType>String</dataType>
        <expression>&quot;Flow Error - &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>Overdue_Task_Name</name>
        <dataType>String</dataType>
        <expression>&quot;Overdue Task - &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <interviewLabel>Overdue Task Scheduled Automation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Overdue Task Scheduled Automation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Overdue_Task_Issue</name>
        <label>Create Overdue Task Issue</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Log_Overdue_Flow_Error</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Description__c</field>
            <value>
                <stringValue>Project Task is due and not completed.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Issue_Status__c</field>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>Overdue_Task_Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Project_Task__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Project__c</field>
            <value>
                <elementReference>$Record.Project__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Reported_By__c</field>
            <value>
                <elementReference>$Record.Assigned_Team_Member__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Severity__c</field>
            <value>
                <stringValue>Medium</stringValue>
            </value>
        </inputAssignments>
        <object>Operational_Issue__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Log_Overdue_Flow_Error</name>
        <label>Log Overdue Flow Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description__c</field>
            <value>
                <stringValue>The Scheduled Flow encountered an error while creating an overdue task issue.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Issue_Status__c</field>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>Flow_Error_Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Project_Task__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Project__c</field>
            <value>
                <elementReference>$Record.Project__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Severity__c</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <object>Operational_Issue__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Task_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Due_Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <dateValue>2026-09-11</dateValue>
            </value>
        </filters>
        <object>Project_Task__c</object>
        <schedule>
            <frequency>Once</frequency>
            <startDate>2026-09-11</startDate>
            <startTime>20:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
